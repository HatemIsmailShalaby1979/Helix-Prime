# ── Helix Prime Cockpit — Environment Variables ────────────────
# Copy to .env and fill in values before running the cockpit.

# ── Ollama (AI agents) ─────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── OpenRouter (study-studio API layer) ────────────────────────
OPENROUTER_API_KEY=

# ── Notion (B2B Onboarding documentation) ──────────────────────
NOTION_API_KEY=

# ── CX Alert Dispatcher (SMTP / webhook) ──────────────────────
CX_SMTP_HOST=
CX_SMTP_PORT=25
CX_SMTP_USER=
CX_SMTP_PASS=
CX_ALERT_FROM=helix-cx@local
CX_ALERT_RECIPIENTS=
CX_ALERT_WEBHOOK=

# ── Governance ─────────────────────────────────────────────────
GOVERNANCE_AGENT=opencode
